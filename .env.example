### =================================
### REQUIRED SERVER ENVIRONMENT VARIABLES
### =================================

### Supabase service role key for admin operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

### Your Moru Infrastructure API URL
INFRA_API_URL=https://api.moru.io

### Default domain for the Moru SDK
### Used for Sandbox Details Page
NEXT_PUBLIC_MORU_DOMAIN=moru.io

### =================================
### REQUIRED CLIENT ENVIRONMENT VARIABLES
### =================================

### Supabase URL and anon key for client-side operations
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

### =================================
### OPTIONAL SERVER ENVIRONMENT VARIABLES
### =================================

### Billing API URL (Required if NEXT_PUBLIC_INCLUDE_BILLING=1)
# BILLING_API_URL=https://billing.moru.io

### Vercel URL (automatically set in Vercel deployments)
# VERCEL_URL=

### Development infrastructure API domain
# DEVELOPMENT_INFRA_API_DOMAIN=

### OTEL Service Name
# OTEL_SERVICE_NAME=

### ZeroBounce API key for email validation (requires KV for caching)
# ZEROBOUNCE_API_KEY=

### KV database configuration (only needed if using ZeroBounce)
# KV_REST_API_TOKEN=
# KV_REST_API_URL=

### Loki Configuration
# LOKI_SERVICE_NAME=
# LOKI_HOST=
# LOKI_USERNAME=
# LOKI_PASSWORD=

### OTEL Configuration
# OTEL_SERVICE_NAME=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_TRACES_EXPORTER=
# OTEL_METRICS_EXPORTER=
# OTEL_LOGS_EXPORTER=
# OTEL_NODE_RESOURCE_DETECTORS= 
# OTEL_RESOURCE_ATTRIBUTES=

### =================================
### OPTIONAL CLIENT ENVIRONMENT VARIABLES
### =================================

### PostHog analytics key
# NEXT_PUBLIC_POSTHOG_KEY=

### =================================
### EXTERNAL SERVICE DOMAINS (for URL rewrites/proxying)
### =================================

### Landing page domain (e.g., moru-landing.vercel.app)
### When set, paths like /, /pricing, /blog will proxy to this domain
# LANDING_PAGE_DOMAIN=

### Documentation domain (e.g., moru.mintlify.app)
### When set, /docs/* paths will proxy to this domain
# DOCUMENTATION_DOMAIN=

### SDK Reference domain (e.g., moru-sdk-docs.vercel.app)
### When set, /docs/sdk-reference/* paths will proxy to this domain
# SDK_REFERENCE_DOMAIN=

### Enable billing features: set to 1 to enable
### When enabled, both BILLING_API_URL and NEXT_PUBLIC_STRIPE_BILLING_URL must be provided
# NEXT_PUBLIC_INCLUDE_BILLING=0

### Set to 1 to use mock data
# NEXT_PUBLIC_MOCK_DATA=0

### Set to 1 to enable verbose logging
# NEXT_PUBLIC_VERBOSE=0

