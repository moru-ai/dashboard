{
  "github": {
    "silent": true
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/docs",
      "has": [
        {
          "type": "query",
          "key": "reason",
          "value": "sdk-missing-api-key"
        }
      ],
      "destination": "/docs?ref=sdk-missing-api-key&reason=",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://moru.mintlify.dev/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://moru.mintlify.dev/docs/:match*"
    }
  ]
}
